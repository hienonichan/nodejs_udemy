<h1>Cart page</h1>

<div>
    <table class="table">
  <thead>
    <tr>
      <th scope="col">STT</th>
      <th scope="col">Title</th>
      <th scope="col">Description</th>
      <th scope="col">price</th>
       <th scope="col">qty</th>
        <th scope="col"></th>
    </tr>
  </thead>
  <tbody>
    {{#each products}}
    <tr>
      <th scope="row">{{@index}}</th>
      <td>{{this.productData.title}}</td>
      <td>{{this.productData.description}}</td>
      <td>{{this.productData.price}}</td>
      <td>{{this.qty}}</td>
       <td><form action="/shop/cart/delete/{{this.productData.id}}?_method=PUT" method="POST">
            <button class="btn btn-primary" type="submit">Gỡ</button>
       </form></td>
    </tr>
    {{/each}}
  </tbody>
</table>
</div>

<div>
    <h1>Thành tiền : {{totalPrice}} VNĐ</h1>
</div>