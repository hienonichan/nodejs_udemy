<h1>Cart page</h1>
<div>
    <table class="table">
  <thead>
    <tr>
      <th scope="col">STT</th>
      <th scope="col">Title</th>
      <th scope="col">Description</th>
      <th scope="col">price</th>
       <th scope="col">qty</th>
        <th scope="col"></th>
    </tr>
  </thead>
  <tbody>
    {{#each products}}
    <tr>
      <th scope="row">{{@index}}</th>
      <td>{{this.title}}</td>
      <td>{{this.description}}</td>
      <td>{{this.price}}</td>
      <td>{{this.cartItem.quantity}}</td>
       <td><form action="/shop/cart/delete/{{this.id}}?_method=DELETE" method="POST">
            <button class="btn btn-primary" type="submit">Xóa khỏi giỏ hàng</button>
       </form></td>
    </tr>
    {{else}}
      <h1>Không có sản phẩm nào trong giỏ hàng</h1>
    {{/each}}
  </tbody>
</table>
</div>

<div>
  <form action="/shop/create-order" method="POST">
     <button class="btn btn-primary">Create Order</button>
  </form>
</div>
